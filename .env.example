# App
PROJECT_NAME="Gym Food RAG"
API_V1_STR="/api/v1"
ADMIN_SECRET_KEY="change-me"
SECRET_KEY="change-me-too"

# LLM
LLM_BACKEND="gemini"
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
