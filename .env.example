POSTGRES_PORT=5432
POSTGRES_USER="admin"
POSTGRES_PASSWORD="admin"
POSTGRES_DB="gym_food_db"

# pgAdmin
PGADMIN_EMAIL="admin@gymfood.com"
PGADMIN_PASSWORD="admin"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
