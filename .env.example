# Embedding
USE_LOCAL_EMBEDDING=True
LOCAL_EMBEDDING_MODEL="BAAI/bge-m3"

# Vector DB
QDRANT_HOST="localhost"
QDRANT_PORT=6333
COLLECTION_NAME="gym_food_hybrid_v1"

# Database
DATABASE_URL=""
