# App
PROJECT_NAME="Gym Food RAG"
API_V1_STR="/api/v1"
ADMIN_SECRET_KEY="change-me"
SECRET_KEY="change-me-too"
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM
LLM_BACKEND="ollama"
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-3.5-turbo"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
NUTRITION_AGENT_ENABLED=true
NUTRITION_AGENT_MODEL="qwen2.5:3b"
NUTRITION_AGENT_REDIS_CHECKPOINT=true

# Embedding
USE_LOCAL_EMBEDDING=True
LOCAL_EMBEDDING_MODEL="BAAI/bge-m3"
SPARSE_EMBEDDING_STRATEGY="auto"
SPARSE_HASH_DIM=2000003
SPARSE_USE_BIGRAMS=true
RETRIEVAL_RERANK_MAX_PASSAGE_LENGTH=256
RETRIEVAL_RERANK_WEIGHTS="0.4,0.2,0.4"

# Vector DB
QDRANT_HOST="localhost"
QDRANT_PORT=6333
COLLECTION_NAME="gym_food_hybrid_v1"
# Sau khi cutover ổn định, app nên query qua alias cố định.
COLLECTION_NAME_ACTIVE="gym_food_hybrid_active"
# Chỉ set COLLECTION_NAME_NEXT khi chuẩn bị reindex sang collection mới.
COLLECTION_NAME_NEXT=""
QDRANT_SPARSE_INDEX_ON_DISK=true
RETRIEVAL_OVERFETCH_MULTIPLIER=4
RETRIEVAL_PREFETCH_MULTIPLIER=2
RETRIEVAL_ENABLE_RERANK=true
RETRIEVAL_ENABLE_NATIVE_RERANK=true
RETRIEVAL_NATIVE_RERANK_TIMEOUT_SECONDS=25
RETRIEVAL_NATIVE_RERANK_MAX_DOCS=6
RETRIEVAL_NATIVE_RERANK_MAX_CHARS=512
UVICORN_RELOAD=false
RETRIEVAL_RERANK_CANDIDATES=24

# Database
DATABASE_URL=""
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="admin"
POSTGRES_PASSWORD="admin"
POSTGRES_DB="gym_food_db"

# pgAdmin
PGADMIN_EMAIL="admin@gymfood.com"
PGADMIN_PASSWORD="admin"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
EXACT_CACHE_TTL_SECONDS=900
WORKFLOW_STATE_TTL_SECONDS=3600
